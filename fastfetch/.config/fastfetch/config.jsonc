{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch",
        "color": {
            "1": "green",
            "2": "cyan"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "green",
            "title": "green"
        }
    },
    "modules": [
        "title", "separator", "os", "kernel", "uptime",
        "packages", "shell", "display", "wm", "terminal",
        "cpu", "gpu", "memory", "swap", "disk",
        "localip", "separator", "colors"
    ]
}
